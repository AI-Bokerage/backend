# Connect the running app as genusg_app (unprivileged, subject to RLS), not
# genusg (the docker-compose bootstrap superuser, which bypasses RLS
# entirely). Run `prisma migrate deploy`/`migrate dev` as genusg — or any
# other privileged role — since CREATE POLICY / FORCE ROW LEVEL SECURITY
# need elevated privileges genusg_app deliberately doesn't have.
DATABASE_URL=postgresql://genusg_app:genusg_app@localhost:5439/genusg
REDIS_URL=redis://localhost:6383
GEN_USG_INTERNAL_SECRET=change-me-dev-secret
PORT=3600

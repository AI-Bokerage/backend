# ── AUTH-SVC environment ───────────────────────────────────────────────────────
# Copy to .env and export vars, or pass to IDE run config. Never commit .env.

# Required
AUTH_DB_URL=
AUTH_DB_USERNAME=
AUTH_DB_PASSWORD=
MAIL_PASSWORD=

# Optional
MAIL_USERNAME=no-reply@yourdomain.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
JWT_ISSUER=https://auth.cpms.io
JWT_AUDIENCE=cpms-api
INTERNAL_SERVICE_SECRET=change-me-in-production
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=ChangeMe@1234
MAGIC_LINK_FRONTEND_URL=http://localhost:8081/reset-password
COOKIE_DOMAIN=
COOKIE_SECURE=false

# AWS KMS (only needed when jwt.signing-mode=kms)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_KMS_KEY_ID=alias/cpms-auth-v1

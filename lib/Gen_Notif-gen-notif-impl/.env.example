# Connect the running app as gennotif_app (unprivileged, subject to RLS), not
# gennotif (the docker-compose bootstrap superuser, which bypasses RLS
# entirely). Run `prisma migrate deploy`/`migrate dev` as gennotif — or any
# other privileged role — since CREATE POLICY / FORCE ROW LEVEL SECURITY
# need elevated privileges gennotif_app deliberately doesn't have.
DATABASE_URL=postgresql://gennotif_app:gennotif_app@localhost:5438/gennotif
REDIS_URL=redis://localhost:6381
JWKS_URL=http://localhost:8081/.well-known/jwks.json
JWT_ISSUER=gen-auth
GEN_NOTIF_INTERNAL_SECRET=change-me-dev-secret
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=no-reply@example.com
ALLOWED_ORIGINS=http://localhost:3000
PORT=3500

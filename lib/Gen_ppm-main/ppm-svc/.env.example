# ── PPM-SVC environment ────────────────────────────────────────────────────────
# Copy to .env and export vars, or pass to IDE run config. Never commit .env.

# Required — none (all have defaults, but override for non-local envs)

# Optional
SERVER_PORT=8087
SPRING_PROFILES_ACTIVE=local
PPM_DB_URL=jdbc:postgresql://localhost:5432/ppmdb
PPM_DB_USERNAME=ppm_owner
PPM_DB_PASSWORD=changeme
PPM_DB_MAX_POOL_SIZE=20
PPM_DB_MIN_IDLE=5
AUTH_SVC_JWKS_URI=http://localhost:8101/.well-known/jwks.json
RABBITMQ_ADDRESSES=amqp://guest:guest@localhost:5672
OUTBOX_RELAY_INTERVAL_MS=5000
OUTBOX_RELAY_BATCH_SIZE=50
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0

#!/usr/bin/env sh

branch=$(git rev-parse --abbrev-ref HEAD)
case "$branch" in
  main|master)
    echo "🚫 Direct commits to '$branch' are blocked — create a feature branch:"
    echo "   git checkout -b feature/your-change"
    echo "Emergency override: git commit --no-verify"
    exit 1
    ;;
esac

pnpm lint-staged

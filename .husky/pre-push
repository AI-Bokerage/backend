#!/usr/bin/env sh

# Checks the actual remote ref being pushed to (from stdin, per git's
# pre-push hook contract: <local ref> <local sha> <remote ref> <remote sha>
# per line) rather than the local branch name — `git push origin main` from
# a differently-named local branch would otherwise slip past a HEAD check.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "🚫 Direct pushes to '$remote_ref' are blocked — push a feature branch and open a PR instead."
      echo "Emergency override: git push --no-verify"
      exit 1
      ;;
  esac
done

echo "Running pre-push checks (lint + typecheck + test)..."
pnpm validate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id        String   @id @default(uuid())
  title     String
  content   String
  ownerId   String   @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// ── modules/platform (Super Admin flow) ─────────────────────────────────────

// Gen_TNT tracks infra-provisioning status (PROVISIONING/ACTIVE/SUSPENDED/...);
// this tracks the separate "has the owner accepted their invite yet?"
// business state the console actually shows (PENDING vs Active) — updated to
// ACTIVE by the webhook modules/auth calls after a TENANT_ADMIN invite is
// accepted. See modules/platform/brokerage.service.ts.
model BrokerageOnboarding {
  tenantId     String    @id
  invitationId String
  status       String    @default("PENDING") // PENDING | ACTIVE
  // Flow 1 cancellation → purge after BROKERAGE_RETENTION_DAYS (purgeCancelledBrokerages).
  cancelledAt  DateTime?
  purgedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Deliberately simple (a plain table, not the full Gen_Audit hash-chained
// ledger service) — see project decision log. Swappable later without an API
// change: same shape a "real" audit consumer would read off the
// platform.audit exchange.
model ActivityLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model BrokerageExportJob {
  id          String    @id @default(uuid())
  tenantId    String
  status      String    @default("EXPORTING") // EXPORTING | READY | FAILED | EXPIRED | DELETED
  filePath    String?
  requestedAt DateTime  @default(now())
  readyAt     DateTime?
  expiresAt   DateTime?
  deletedAt   DateTime?

  @@index([tenantId])
}

// Backs AiCostLimitProvider (implements Gen_USG's ILimitProvider). A present,
// unexpired row means "Allow extra for today" was clicked — getLimits()
// returns AI_COST_OVERRIDE_LIMIT instead of AI_COST_DAILY_LIMIT until
// expiresAt, then it reverts on its own ("resets by itself tomorrow"), no
// cleanup job needed.
model AiCostLimitOverride {
  tenantId  String   @id
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

// ── modules/crm (Team Lead / Broker flow — Flow 3, and now Flow 4's core) ──

// "Lead" vs "Client" is just this same stage field — NEW..APPROVED are
// leads, FUNDED is a client, LOST is neither — not a separate table, so a
// funding doesn't require moving a row between models.
enum LeadStage {
  NEW
  QUALIFIED
  APPLICATION
  UNDERWRITING
  APPROVED
  FUNDED
  LOST
}

// SOW 4.16/6.3 — orthogonal to the pipeline `stage`: a Lost/Funded deal is
// still ACTIVE here, this only tracks whether the file itself is retired.
enum FileStatus {
  ACTIVE
  INACTIVE
}

model Lead {
  id                    String                @id @default(uuid())
  tenantId              String
  brokerUserId          String
  name                  String
  email                 String?
  phone                 String?
  // SOW 5.12 — "Client name, city, assignment, tags, and file status."
  city                  String?
  fileStatus            FileStatus            @default(ACTIVE)
  stage                 LeadStage             @default(NEW)
  lostReason            String?
  // Flow 4.6 "Reason is required, note is optional".
  lostNote              String?
  // "New client" form fields (Flow 4.1) — single-applicant scope, no
  // co-applicant modeling (that's a bigger schema than this CRM core needs).
  income                Float?
  monthlyDebts          Float?
  downPayment           Float?
  propertyAddress       String?
  propertyValue         Float?
  // "Original notes - read only" (Flow 4.3/4.2) — the source record, locked
  // once set. brokerNotes is "Your notes - editable"; edits to it are
  // recorded on the activity log as their own append-only history.
  notes                 String?
  brokerNotes           String?
  tags                  String[]              @default([])
  dateOfBirth           DateTime?
  // "Hidden values" (Flow 4.3) — SIN and bank details are encrypted at rest
  // (see modules/crm/encryption.ts) and only ever leave the server through
  // the reveal endpoint, which records the reveal on the activity log.
  sin                   String?
  bankDetails           String?
  // "Recalculate everyone" (Flow 4.4) cache — the tab itself always
  // recomputes live; this is what a book-wide recalculation writes to.
  affordabilitySnapshot Json?
  // Smart search (search-svc): fingerprint of the text last sent, so only changed people are re-sent.
  searchHash            String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  tasks                 Task[]
  mortgages             Mortgage[]
  appointments          Appointment[]
  emailDrafts           EmailDraft[]
  // Flow 4.5 "Tick which documents this person needs to send".
  requiredDocuments     DocumentType[]        @default([])
  documents             LeadDocument[]
  documentRequests      DocumentRequestLink[]
  // SOW Module 5's structured intake — additive alongside the flat fields
  // above, which stay as a lightweight fallback (see AffordabilityResult's
  // own comment in affordability.service.ts for how the two combine).
  applicants            Applicant[]
  debts                 Debt[]
  properties            PropertyRecord[]
  fundsSources          FundsSource[]
  followUps             FollowUp[]

  // No teamId column: "which team is this lead's broker on" is resolved live
  // against modules/auth (the source of truth for team membership) rather
  // than denormalized here, so a broker moving teams can never leave a stale
  // team_id behind on their leads — see modules/crm/modauth.client.ts.
  @@index([tenantId])
  @@index([brokerUserId])
  @@index([stage])
}

// ── Structured intake (SOW Module 5) ────────────────────────────────────────

// SOW 5.1/5.3 — one to four per lead, enforced in intake.service.ts (the
// schema itself doesn't cap it, same as every other "business rule, not a
// DB constraint" in this codebase).
model Applicant {
  id          String       @id @default(uuid())
  leadId      String
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String?
  phone       String?
  address     String?
  dateOfBirth DateTime?
  brokerNotes String?
  createdAt   DateTime     @default(now())
  employments Employment[]
  noaIncomes  NoaIncome[]

  @@index([leadId])
}

enum EmploymentType {
  EMPLOYED
  SELF_EMPLOYED
  CORPORATION
}

// SOW 5.4/5.5/5.6 — multiple jobs per applicant, hence a child table of
// Applicant rather than fields on it.
model Employment {
  id          String         @id @default(uuid())
  applicantId String
  applicant   Applicant      @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  type        EmploymentType
  employer    String?
  position    String?
  startDate   DateTime?
  baseSalary  Float?
  // {"2024": 95000, "2023": 91000} — a map, not fixed columns, since "the
  // required years" is a moving target this schema shouldn't hardcode.
  t4Values    Json?
  createdAt   DateTime       @default(now())

  @@index([applicantId])
}

// SOW 5.7 — Notice of Assessment line 15000, 2 years per applicant.
model NoaIncome {
  id          String    @id @default(uuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  taxYear     Int
  totalIncome Float
  createdAt   DateTime  @default(now())

  @@unique([applicantId, taxYear])
}

// SOW 5.8 — balance + monthly payment; "configurable payment calculation
// rules" is a future lender-rules concern, not modeled here yet.
model Debt {
  id             String   @id @default(uuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  description    String?
  balance        Float
  monthlyPayment Float
  createdAt      DateTime @default(now())

  @@index([leadId])
}

// SOW 5.9 — properties the applicant(s) already own, distinct from
// Lead.propertyAddress/propertyValue (the property being purchased).
model PropertyRecord {
  id              String    @id @default(uuid())
  leadId          String
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  address         String
  propertyTaxes   Float?
  isCondo         Boolean   @default(false)
  isRental        Boolean   @default(false)
  mortgageBalance Float?
  mortgageLender  String?
  maturityDate    DateTime?
  ownership       String?
  createdAt       DateTime  @default(now())

  @@index([leadId])
}

// SOW 5.10 — repeatable funds-source rows for the down payment.
model FundsSource {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  accountType String
  amount      Float
  isGift      Boolean  @default(false)
  giftSource  String?
  createdAt   DateTime @default(now())

  @@index([leadId])
}

// SOW 5.11 — distinct from Task: a follow-up is a scheduled commitment
// attached to the intake itself, not a generic to-do.
model FollowUp {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String
  scheduledAt DateTime
  createdAt   DateTime @default(now())

  @@index([leadId])
}

// "Change the stage to Funded" cannot be skipped without one of these (see
// lead.service.ts's fundLead) — a client can hold more than one, each with
// its own lender and dates, hence a separate table rather than fields on Lead.
model Mortgage {
  id             String   @id @default(uuid())
  leadId         String
  lender         String
  interestRate   Float
  balance        Float
  monthlyPayment Float
  maturityDate   DateTime
  createdAt      DateTime @default(now())
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([maturityDate])
}

// Tenant Admin's own settings screen (Flow 2) — a handful of display
// fields, not a full business-profile system.
model TenantProfile {
  tenantId     String   @id
  displayName  String?
  supportEmail String?
  phone        String?
  address      String?
  updatedAt    DateTime @updatedAt
}

// Booking page setup, settings/config only (per the agreed scope) — no
// real public scheduling/availability engine behind it yet.
model BookingPageSettings {
  tenantId            String   @id
  slug                String   @unique
  enabled             Boolean  @default(false)
  bufferMinutes       Int      @default(15)
  // Who a brand-new lead from the public booking page is assigned to.
  defaultBrokerUserId String?
  updatedAt           DateTime @updatedAt
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id             String       @id @default(uuid())
  tenantId       String
  brokerUserId   String
  leadId         String?
  title          String
  dueDate        DateTime?
  completed      Boolean      @default(false)
  // Flow 4.9 — "Suggested by AI": not a real task until approved (dismiss deletes it).
  suggested      Boolean      @default(false)
  priority       TaskPriority @default(MEDIUM)
  // Flow 4.9 "The person was deleted? → shown separately as unlinked".
  unlinked       Boolean      @default(false)
  // notes-svc suggestion (and its run) — the same AI suggestion never becomes two
  // tasks, and approve/dismiss is recorded there so asking again skips it.
  aiSuggestionId String?      @unique
  aiRunId        String?
  createdAt      DateTime     @default(now())
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([brokerUserId])
  @@index([leadId])
}

// "Connect email/calendar" (Flow 4.12) — one Google account per broker/team
// lead. accessToken/refreshToken are AES-256-GCM ciphertext (see
// modules/crm/google/token-encryption.ts), never plaintext at rest.
model GoogleConnection {
  userId       String   @id
  tenantId     String
  googleEmail  String?
  accessToken  String
  refreshToken String
  scope        String
  expiresAt    DateTime
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A meeting (Flow 4.8). googleEventId stays null — "stays in the CRM only" —
// until/unless the owning broker has a GoogleConnection to push it to.
// Flow 4.8 "New appointment: call · consultation · document review".
enum AppointmentType {
  CALL
  CONSULTATION
  DOCUMENT_REVIEW
}

model Appointment {
  id            String          @id @default(uuid())
  tenantId      String
  brokerUserId  String
  leadId        String?
  title         String
  type          AppointmentType @default(CONSULTATION)
  startTime     DateTime
  endTime       DateTime
  googleEventId String?
  // Flow 4.8 "Pushed across? No → queued and retried quietly" — see reminder.service.ts.
  pushAttempts  Int             @default(0)
  // Flow 4.8 public booking — "Have we seen this booking before?"
  externalRef   String?
  createdAt     DateTime        @default(now())
  lead          Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([tenantId, externalRef])
  @@index([tenantId])
  @@index([brokerUserId])
  @@index([startTime])
}

// ── Contacts / Centres of Influence (SOW Module 14) ─────────────────────────

// SOW 14.2 — exactly these seven, no "Other" category.
enum ContactCategory {
  REALTOR
  LAWYER
  APPRAISER
  INSURANCE
  ACCOUNTANT
  HOME_INSPECTOR
  FINANCIAL_ADVISOR
}

// The broker's own referral network (glossary: "COI... the broker's referral
// contact network") — scoped like Lead/Task, not tenant-shared. SOW 14.8
// explicitly leaves client/referral linkage undefined, so no leadId here.
model Contact {
  id              String          @id @default(uuid())
  tenantId        String
  brokerUserId    String
  category        ContactCategory
  name            String
  company         String?
  phone           String?
  email           String?
  dateOfBirth     DateTime?
  address         String?
  city            String?
  lastContactedAt DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([tenantId])
  @@index([brokerUserId])
  @@index([category])
}

// Flow 4.7 — "Save draft, nothing is sent". aiAssisted marks a draft that
// started from the AI draft ("marked as AI-assisted"). Deleted once sent.
model EmailDraft {
  id           String   @id @default(uuid())
  tenantId     String
  brokerUserId String
  leadId       String
  intent       String?
  subject      String
  body         String
  aiAssisted   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([leadId])
}

// Flow 4.12 — per-user CRM settings. No row means the defaults (AI on).
model CrmUserSettings {
  userId    String   @id
  tenantId  String
  aiEnabled Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// ── Documents (Flow 4.5) ────────────────────────────────────────────────────

enum DocumentType {
  ID
  T4
  NOA
  PAY_STUB
  EMPLOYMENT_LETTER
  BANK_STATEMENT
  PURCHASE_AGREEMENT
  MORTGAGE_STATEMENT
  PROPERTY_TAX
  OTHER
}

// "Could the system read it?" — read by the AI document service (docread-svc).
enum DocumentReadStatus {
  PENDING
  READ
  PARTIAL
  FAILED
}

model LeadDocument {
  id           String             @id @default(uuid())
  tenantId     String
  leadId       String
  type         DocumentType
  fileName     String
  mimeType     String
  size         Int
  storagePath  String
  // BROKER uploaded it themselves; BORROWER came through the request link.
  uploadedBy   String
  readStatus   DocumentReadStatus
  // docread-svc's id for its copy; its review holds the values read until approved.
  aiDocumentId String?
  createdAt    DateTime           @default(now())
  lead         Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([leadId])
}

// "Works for that one person only, expires after 7 days."
model DocumentRequestLink {
  id        String   @id @default(uuid())
  tenantId  String
  leadId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

// ── Notifications + reminders ──────────────────────────────────────────────

// In-app notifications ("broker notified", reminders, the 9am digest).
model Notification {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  type      String
  title     String
  body      String?
  leadId    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// One row per reminder already sent, so the hourly sweep never repeats one.
model ReminderLog {
  key       String   @id
  createdAt DateTime @default(now())
}

// Flow 4.11 / Flow 1: a deleted person's copies in the AI services still to be
// wiped. Each service's delete is idempotent; the ones that failed (service
// down) stay in `pending` and are retried hourly until none are left.
model AiDataDeletion {
  id        String   @id @default(uuid())
  tenantId  String
  clientId  String
  pending   String[]
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, clientId])
}

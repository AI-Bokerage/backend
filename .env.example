NODE_ENV=development
PORT=4000
APP_NAME=Enterprise Backend Template
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info

# Security
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Database
DB_CLIENT=prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/template_db
MONGODB_URI=mongodb://localhost:27017/template_db

# modules/platform (Super Admin console) — talks to modules/auth (8102) and
# modules/tenant (8103); see docker-compose.yml for the containerized values.
AUTH_SERVICE_BASE_URL=http://localhost:8102
TENANT_SERVICE_BASE_URL=http://localhost:8103
INTERNAL_SERVICE_SECRET=dev-only-internal-secret-change-me
# Paste the contents of modules/auth/src/main/resources/keys/public.pem here
# (escape newlines as \n, or use a multi-line env value if your loader supports it)
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_ISSUER=https://auth.example.com
AUTH_JWT_AUDIENCE=example-api
BROKERAGE_EXPORT_DOWNLOAD_DAYS=7
# Days after a brokerage is cancelled before its CRM data and documents are permanently deleted.
BROKERAGE_RETENTION_DAYS=90
BROKERAGE_EXPORT_RETENTION_DAYS=30

# modules/crm — Google OAuth ("Connect email/calendar", Flow 4.7/4.8).
# Leave blank to run without this feature; the connect/send endpoints 500
# with a clear message instead of silently misbehaving. To enable it:
#   1. Google Cloud Console -> enable the Calendar API and the Gmail API
#   2. Credentials -> Create OAuth client ID -> Web application
#   3. Add the exact GOOGLE_REDIRECT_URI below as an authorized redirect URI
#   4. OAuth consent screen -> add scopes calendar.events, gmail.send,
#      userinfo.email -> add your own Google account as a test user
#      (gmail.send is a sensitive scope; test users don't need Google's
#      app-verification review)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/crm/integrations/google/callback
# 32-byte hex key (e.g. `openssl rand -hex 32`) for AES-256-GCM encryption of
# stored Google tokens — the default below is fine for local dev only.
TOKEN_ENCRYPTION_KEY=eed03caf5b9fad03e8fb6243a466ed9d2eda77b629fa50899c4eff234b68f8cc

# modules/crm — documents, borrower upload links, reminders (Flow 4.5/4.8).
CRM_FRONTEND_URL=http://localhost:3000
DOCUMENT_STORAGE_DIR=storage/documents
DOCUMENT_MAX_BYTES=20971520
CRM_REMINDERS_ENABLED=true

# Optional — hosted Postgres on Neon instead of the local containers
# (docker compose -f docker-compose.yml -f docker-compose.neon.yml up -d).
# See docs/manual-testing.md, Part F.
# NEON_POOLER_HOST=ep-xxxx-pooler.<region>.aws.neon.tech
# NEON_DIRECT_HOST=ep-xxxx.<region>.aws.neon.tech
# NEON_USER=neondb_owner
# NEON_PASSWORD=
# NEON_USAGE_APP_PASSWORD=
